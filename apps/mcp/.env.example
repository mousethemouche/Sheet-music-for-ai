# MCP server (apps/mcp) runtime configuration. Placeholders only: never
# commit real values. Validated at start (src/config.ts); a missing or
# invalid variable stops the process with a log line naming it (never its
# value). See docs/architecture/MCP_SERVER.md §7.

# Required. Canonical public URL of the MCP endpoint, which is the OAuth
# protected resource: https (http only on localhost), path /mcp, no query.
# The RFC 9728 metadata is served at
# <origin>/.well-known/oauth-protected-resource/mcp, and this origin serves
# the View's playback assets at /assets/ (declared in the ui:// resource CSP).
MCP_PUBLIC_URL=https://mcp.example.com/mcp

# Required. Supabase project URL (origin only). The token issuer
# (<url>/auth/v1) and the JWKS (<url>/auth/v1/.well-known/jwks.json) are
# derived from it. No secret is needed to verify tokens.
SUPABASE_URL=https://your-project-ref.supabase.co

# Required. Postgres URL of the server login role (a member of score_owner).
# On Supabase: the Supavisor transaction pooler (port 6543). Secret. No TLS
# parameter (sslmode, sslrootcert, ...): TLS is set by DATABASE_CA_CERT only.
DATABASE_URL=postgresql://server_role:change-me@db.example.com:6543/postgres

# Required unless DATABASE_URL is on the loopback host (local tests). PEM
# certificate of the database CA (on Supabase: Database Settings > SSL
# Configuration > Download certificate): every connection is then TLS, with
# the server certificate and host name verified against it. Public, not a
# secret. Multi-line value: set it from the file, never from a literal here.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----
# ...
# -----END CERTIFICATE-----"

# Optional. Comma-separated exact browser origins allowed to call /mcp
# cross-origin (MCP host backends send no Origin). Default: none.
MCP_ALLOWED_ORIGINS=

# Optional. "resource" (default, the only conformant mode: the token aud must
# contain MCP_PUBLIC_URL, added by the Supabase Custom Access Token Hook) or
# "interim-authenticated" (aud "authenticated"; the explicit override of
# docs/architecture/AUTH_MCP_OAUTH.md §4, only after the owner sign-off,
# logged as a warning at every start). Any other value is refused.
MCP_AUTH_AUDIENCE_MODE=resource

# Optional. Proxy hops in front of the server (Express "trust proxy"), so the
# per-IP rate limit sees the client address. Default 0 (no proxy trusted) for
# `node dist/server/main.js`; the Vercel Function adapter defaults to 1 (the
# Vercel edge) when it is unset.
MCP_TRUST_PROXY_HOPS=0

# Optional. Listening port. Default 3001.
PORT=3001

# Optional. The built single-file View; its assets/ directory next to it is
# served at /assets/. Default: dist/view/index.html next to the server bundle.
# MCP_VIEW_HTML_PATH=dist/view/index.html
