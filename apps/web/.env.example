# Web app configuration (Vite). Copy to apps/web/.env.local for local development.
# Every VITE_* value is compiled into the PUBLIC browser bundle.

# Supabase project URL: https://<project-ref>.supabase.co (or http://127.0.0.1:54321 for a local stack).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase PUBLISHABLE key (sb_publishable_...). The app refuses to start with any other key.
# NEVER put a secret (sb_secret_...) or service_role key here: it would ship to every visitor.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>

# Saved-library HTTP API (apps/api) base URL, without a trailing slash: the app calls
# <base>/scores and <base>/scores/:id with the user's access token. https is required,
# except http://localhost / 127.0.0.1 / [::1] for local development
# (e.g. http://localhost:3000 with API_ALLOWED_ORIGINS=http://localhost:5173 on the API).
VITE_API_BASE_URL=https://api.example.com

# Nothing to configure for the player: the build serves the piano SoundFont (with its
# LICENSE.txt and NOTICE.txt) at /assets/soundfonts/piano/ and the SpessaSynth worklet
# under /assets/ from this app's own origin.
