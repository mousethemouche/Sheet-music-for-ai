# HTTP API configuration (apps/api, docs/architecture/API.md). Placeholders only:
# set real values in the deployment environment, never in the repository.

# Supabase project URL: https://<project-ref>.supabase.co (or http://127.0.0.1:54321 for a local stack).
# The token issuer (<url>/auth/v1) and the JWKS URL are derived from it; no key is needed to verify tokens.
SUPABASE_URL=https://<project-ref>.supabase.co

# PostgreSQL URL of the server login role (a member of score_owner, docs/architecture/DATABASE.md).
# SECRET: contains the password. On Supabase, the transaction pooler URL (port 6543).
DATABASE_URL=postgres://<login-role>:<password>@<host>:6543/postgres

# Exact browser origins allowed to call the API (the web app), comma-separated.
# https only, except http on a loopback host. Empty: no browser origin is allowed.
API_ALLOWED_ORIGINS=https://<web-app-host>

# Listening port of `pnpm --filter @sheet-music/api start`. Default 3000.
PORT=3000
